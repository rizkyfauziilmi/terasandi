{
  "name": "terasandi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:reset": "docker compose down -v && pnpm db:setup",
    "auth:generate": "pnpm dlx auth@latest generate",
    "auth:migrate": "pnpm dlx auth@latest migrate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.6",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.21.0"
}
