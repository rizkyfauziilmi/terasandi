{
  "name": "terasandi",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @terasandi/contracts build && pnpm -r --parallel run dev",
    "format": "pnpm --filter api format",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:watch": "pnpm --filter api test:watch",
    "test:cov": "pnpm --filter api test:cov",
    "test:e2e": "pnpm --filter api test:e2e",
    "db:prepare": "pnpm --filter api db:prepare",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:push": "pnpm --filter api db:push",
    "db:pull": "pnpm --filter api db:pull",
    "db:studio": "pnpm --filter api db:studio",
    "docker:up": "pnpm --filter api docker:up",
    "docker:down": "pnpm --filter api docker:down",
    "docker:reset": "pnpm --filter api docker:reset",
    "docker:logs": "pnpm --filter api docker:logs"
  }
}
