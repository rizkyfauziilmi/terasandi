# Postgres (docker compose)
POSTGRES_USER=terasandi
POSTGRES_PASSWORD=terasandi
POSTGRES_DB=terasandi
POSTGRES_PORT=5432

# App
PORT=3001
DATABASE_URL=postgres://terasandi:terasandi@localhost:5432/terasandi
# Log levels: a level (warn), a list (warn,error) or a threshold (>=debug).
# Defaults to >=debug in development and >=log in production.
LOG_LEVEL=">=debug"

# Auth
# Generate with: openssl rand -base64 32
JWT_SECRET=
# Express `trust proxy`: true when the API runs behind a reverse proxy, so
# rate limits see the client address.
TRUST_PROXY=false
# Sign-in attempts per address and username, and per address alone, per minute.
AUTH_RATE_LIMIT=5
AUTH_IP_RATE_LIMIT=20

# MinIO (docker compose)
MINIO_ROOT_USER=terasandi
MINIO_ROOT_PASSWORD=terasandi-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Storage (S3-compatible; MinIO needs the path-style lookup)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=terasandi-files
STORAGE_ACCESS_KEY=terasandi
STORAGE_SECRET_KEY=terasandi-dev-secret
STORAGE_FORCE_PATH_STYLE=true
